# Teen-Hub/.npmrc
# Forces the real public npm registry. Without this, a build environment
# that has NPM_CONFIG_REGISTRY (or similar) pointing at Replit's internal
# package-firewall proxy — which only resolves inside Replit's own sandbox —
# will fail on Vercel with ENOTFOUND, since that address isn't reachable
# from anywhere else.
registry=https://registry.npmjs.org/
